# Backend (Koyeb)
# Copy this file to backend/.env and replace the placeholder values.

# Runtime
APP_ENV=production
HOST=0.0.0.0
PORT=8000

# Frontend origin used for CORS allowlisting
FRONTEND_URL=https://coral-workspace.vercel.app/

# Semantic engine public endpoint (e.g. deployed on Render)
SEMANTIC_ENGINE_URL=https://coral-workspace.onrender.com

# Production PostgreSQL connection string (Neon or equivalent managed Postgres)
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Production Redis connection string (Upstash or equivalent managed Redis)
REDIS_URL=rediss://default:<password>@<host>:<port>

# JWT signing secret for backend auth
SECRET_KEY=replace-with-a-long-random-secret

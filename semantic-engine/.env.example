# Semantic Engine Configuration
#
# Copy this file to .env and configure for your environment.
#
# === LOCAL OLLAMA ===
# MODEL_PROVIDER=ollama
# MODEL_NAME=qwen2.5:7b
# MODEL_BASE_URL=http://localhost:11434
#
# === REMOTE LLM (via OpenAI-compatible API) ===
# MODEL_PROVIDER=openai
# MODEL_NAME=qwen2.5:7b
# MODEL_BASE_URL=https://<your-ngrok-url>.ngrok-free.app/v1
# MODEL_API_KEY=
#
# === GROQ (for quick prototyping only) ===
# MODEL_PROVIDER=openai
# MODEL_NAME=mixtral-8x7b-32768
# MODEL_BASE_URL=https://api.groq.com/openai/v1
# MODEL_API_KEY=gsk_...

# Service
APP_NAME=CoralTeams Semantic Engine
APP_VERSION=0.1.0
DEBUG=true
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=info

# Model Provider
MODEL_PROVIDER=openai
MODEL_NAME=qwen2.5:7b
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_API_KEY=

# Coral
CORAL_BINARY=/workspaces/coral/target/debug/coral
CORAL_BASE_URL=http://localhost:5555
CORAL_API_KEY=

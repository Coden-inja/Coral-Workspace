# Semantic Engine Privacy-First Configuration
# Copy this file to .env and configure only private/isolated inference endpoints.

# Service
APP_NAME=CoralTeams Semantic Engine
APP_VERSION=0.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=info

# Model selection (small CPU-friendly model for private cloud mode)
MODEL_NAME=qwen2.5:3b

# ARCHITECTURE MODE A — Sovereign Demo Mode
# Secure admin-controlled tunnel to locally hosted Ollama (no public aggregator API usage)
# OLLAMA_HOST=https://your-secure-tunnel.ngrok-free.app

# ARCHITECTURE MODE B — Self-Contained Private Cloud CPU Mode
# Internal container-only Ollama endpoint (no internet egress)
OLLAMA_HOST=http://ollama-service:11434

# Coral binary command available in container PATH after build-time install
CORAL_BINARY=coral

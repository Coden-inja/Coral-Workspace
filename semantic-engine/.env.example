# Semantic Engine Configuration
# Copy this file to .env and configure the environment variables below.

# Service
APP_NAME=CoralTeams Semantic Engine
APP_VERSION=0.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=info

# Model selection (e.g. qwen2.5:3b, llama3.2, etc.)
MODEL_NAME=qwen2.5:3b

# =========================================================================
# OLLAMA / LLM INFRASTRUCTURE MODES
# =========================================================================

# MODE A: Google Colab + Ngrok Free Cloud GPU Mode (100% Free T4 GPU, No Card)
# If running colab_model_server.ipynb on Google Colab to offload the LLM:
# OLLAMA_HOST=https://your-ngrok-tunnel.ngrok-free.app

# MODE B: Self-Contained Private Cloud / Docker Compose Mode
# If running Ollama as a service within the same docker-compose stack:
OLLAMA_HOST=http://ollama-service:11434

# MODE C: Local Native Mode
# If running Ollama natively on localhost:
# OLLAMA_HOST=http://localhost:11434

# =========================================================================
# CORAL ENGINE CLI SETTINGS
# =========================================================================
# Coral binary command available in container PATH after build-time install
CORAL_BINARY=coral
